# Typed fixture projects ship hand-written @cancjs/* stubs under a node_modules dir so type-aware
# rule tests resolve them like real installs. These are source, not installed deps: keep them.
!tests/fixtures/projects/*/node_modules/
!tests/fixtures/projects/*/node_modules/**

# Killed lane runs leave these behind
tests/integration/lane*/tmp/
tests/integration/lane*/tmp-pack/
