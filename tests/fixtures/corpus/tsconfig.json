{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@cancjs/*": [
        "../projects/default/node_modules/@cancjs/*",
        "../projects/default/node_modules/@cancjs/*/index.d.ts",
        "../projects/default/node_modules/@cancjs/*.d.ts"
      ],
      "@cancjs/promise/dist/*": [
        "../projects/default/node_modules/@cancjs/promise/*.d.ts"
      ]
    }
  },
  "include": ["**/*.ts"]
}
