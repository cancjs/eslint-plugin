{
 "compilerOptions": {
 "target": "ES2022",
 "module": "NodeNext",
 "moduleResolution": "NodeNext",
 "lib": ["ES2022"],
 "outDir": "./dist",
 "strict": true,
 "skipLibCheck": true,
 "esModuleInterop": true,
 "resolveJsonModule": true,
 "declaration": true,
 "declarationMap": true,
 "sourceMap": true,
 "noEmit": true,
 "types": ["node", "vitest/globals"]
 },
 "include": ["src", "tests"],
 "exclude": ["tests/fixtures/corpus"]
}
