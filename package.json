{
  "name": "@cancjs/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint rules for cancelable promises and coroutines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cancjs/eslint-plugin.git"
  },
  "homepage": "https://github.com/cancjs/eslint-plugin#readme",
  "bugs": "https://github.com/cancjs/eslint-plugin/issues",
  "author": "bisubus",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native.d.mts",
        "default": "./dist/native.mjs"
      },
      "require": {
        "types": "./dist/native.d.cts",
        "default": "./dist/native.cjs"
      }
    }
  },
  "engines": {
    "node": ">=18.18",
    "npm": ">=9"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "smoke:pack": "vitest run tests/pack-smoke",
    "pack:install": "node scripts/pack-install.mjs",
    "test:integration:setup": "npm ci --prefix tests/integration/lane9 && npm ci --prefix tests/integration/lane10",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:src": "eslint ./src",
    "lint:all": "eslint .",
    "format": "eslint --fix .",
    "format:src": "eslint --fix ./src",
    "format:all": "eslint --fix .",
    "gen:stubs": "node scripts/gen-fixture-stubs.mjs",
    "docs": "eslint-doc-generator scripts/docs-plugin",
    "docs:check": "eslint-doc-generator scripts/docs-plugin --check",
    "prepublishOnly": "npm run build && npm run lint && npm run typecheck && npm run test"
  },
  "files": ["dist", "docs", "!dist/**/*.map"],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "canc",
    "cancel",
    "cancelable",
    "abort",
    "promise"
  ],
  "dependencies": {
    "@typescript-eslint/type-utils": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "ts-api-utils": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "~26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/rule-tester": "^8.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-doc-generator": "^3.0.0",
    "eslint-package-json": "^0.3.0",
    "eslint-plugin-eslint-plugin": "^7.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^56.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9 || ^10",
    "typescript": ">=5 <6.1"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    }
  }
}
